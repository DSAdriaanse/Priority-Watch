# Copy to .env on the server. Never commit the real file.

# Public URL of the app (used in alert messages and links)
APP_URL=https://priority.apps.swcrs.org

# Inbound webhook from the repeater system. REQUIRED. Sent in a header, not the URL.
INBOUND_WEBHOOK_SECRET=

# SMS (Textbelt)
TEXTBELT_KEY=

# Slack bot (optional)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#priority-watch

# Allmon3 (AllStarLink node control)
ALLMON_BASE_URL=
ALLMON_USER=
ALLMON_PASS=

# WordPress incident publishing (optional)
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=

# AI incident summaries (optional)
ANTHROPIC_API_KEY=

# Email is configured in the PocketBase admin UI (SMTP), not here.
