# Copy to /etc/priority-watch/env on the server (mode 600). Never commit the real file.
# Non-secret integration settings (WordPress URL, Allmon3 URL/user, Slack channel,
# message template) are edited in the app under Settings. Secrets live only here.

# Where the app listens. Set by the installer; to change any of these re-run setup with the matching
# option (--port, --mode, --listen, --proxy-ip), because Nginx and the firewall have to follow.
#   PW_PORT        the port. Give each copy of the app on one server its own port.
#   PW_LISTEN      127.0.0.1 when Nginx runs on this server; the server's address when an external proxy connects.
#   PW_MODE        local (Nginx and TLS here) or proxy (an external reverse proxy handles TLS)
#   PW_PROXY_IPS   proxy mode: the proxy address or range let through the firewall
PW_PORT=8090
PW_LISTEN=127.0.0.1
PW_MODE=local
PW_PROXY_IPS=

# Public URL of the app (used in alert messages and password-setup links)
APP_URL=https://priority.apps.swcrs.org

# Inbound webhook from the repeater system. REQUIRED (the endpoint answers 503 without it).
# Sent in the X-Webhook-Secret header. Generate one:  openssl rand -hex 32
INBOUND_WEBHOOK_SECRET=

# SMS (Textbelt)
TEXTBELT_KEY=

# Slack bot (optional)
SLACK_BOT_TOKEN=

# Allmon3 password (username and base URL are in Settings)
ALLMON_PASS=

# WordPress application password (URL and username are in Settings)
WORDPRESS_APP_PASSWORD=
# publish | draft  (default publish)
#WORDPRESS_POST_STATUS=draft

# AI incident summaries (optional; without it, a plain summary is kept and no post is published)
ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-5-5

# Email (password setup + team alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
MAIL_FROM_ADDRESS=priority@swcrs.org
MAIL_FROM_NAME=GMRS Priority Watch

# Behind Nginx on the same host. Makes rate limits see the real client IP.
TRUST_PROXY_HEADER=X-Real-IP
# Webhook/functions requests allowed per minute per client IP (default 30)
#WEBHOOK_RATE_LIMIT=30
