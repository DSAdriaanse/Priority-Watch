{
  "name": "IncidentUpdate",
  "type": "object",
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "operator_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "note",
        "link_repeater",
        "delink_repeater",
        "contact_made",
        "status_change",
        "guidance_followed",
        "alert",
        "assignment",
        "resolution"
      ],
      "default": "note"
    }
  },
  "required": [
    "incident_id",
    "message"
  ]
}