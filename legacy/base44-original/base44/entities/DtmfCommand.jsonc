{
  "name": "DtmfCommand",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name for the command"
    },
    "dtmf": {
      "type": "string",
      "description": "DTMF tone sequence",
      "pattern": "^[0-9A-D*#]{1,24}$"
    },
    "confirm_required": {
      "type": "boolean",
      "default": true
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "dtmf"
  ]
}