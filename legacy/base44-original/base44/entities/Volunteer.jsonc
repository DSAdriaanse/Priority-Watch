{
  "name": "Volunteer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "callsign": {
      "type": "string",
      "description": "GMRS callsign"
    },
    "phone": {
      "type": "string",
      "description": "Mobile number for SMS notifications"
    },
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "operator",
        "priority_watch"
      ],
      "default": "operator"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notify_sms": {
      "type": "boolean",
      "default": true
    },
    "notify_email": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}