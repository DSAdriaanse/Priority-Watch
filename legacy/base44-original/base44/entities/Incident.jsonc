{
  "name": "Incident",
  "type": "object",
  "properties": {
    "repeater_id": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Repeater IDs associated with this incident"
    },
    "repeater_name": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Repeater names associated with this incident"
    },
    "alert_type": {
      "type": "string",
      "description": "Type of inbound alert"
    },
    "incident_category": {
      "type": "string",
      "description": "CAP-aligned top-level incident category",
      "enum": [
        "medical",
        "fire",
        "law_enforcement",
        "weather",
        "transportation",
        "utility",
        "rescue",
        "hazard",
        "other"
      ]
    },
    "incident_subtype": {
      "type": "string",
      "description": "Specific scenario within the category (free text)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "standby",
        "resolved"
      ],
      "default": "active"
    },
    "priority_level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "high"
    },
    "source_dtmf": {
      "type": "string",
      "description": "DTMF code that triggered the alert"
    },
    "caller_info": {
      "type": "string",
      "description": "Caller name/callsign and contact"
    },
    "location_info": {
      "type": "string",
      "description": "Reported location of the emergency"
    },
    "nature": {
      "type": "string",
      "description": "Description of the emergency"
    },
    "summary": {
      "type": "string",
      "description": "Operator-entered summary"
    },
    "ai_summary": {
      "type": "string",
      "description": "AI-generated incident summary on resolution"
    },
    "wordpress_post_url": {
      "type": "string"
    },
    "assigned_operator": {
      "type": "string"
    },
    "resolved_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": []
}