{
  "name": "Repeater",
  "type": "object",
  "properties": {
    "node_number": {
      "type": "string",
      "description": "Short node identifier used in linked-repeater networks"
    },
    "name": {
      "type": "string",
      "description": "Repeater name/identifier"
    },
    "callsign": {
      "type": "string",
      "description": "FCC callsign"
    },
    "location": {
      "type": "string",
      "description": "City or site description"
    },
    "state": {
      "type": "string",
      "description": "US state abbreviation"
    },
    "frequency": {
      "type": "string",
      "description": "TX frequency e.g. 462.675 MHz"
    },
    "coverage_area": {
      "type": "string",
      "description": "General coverage description"
    },
    "link_webhook_url": {
      "type": "string",
      "description": "Webhook URL to link this repeater"
    },
    "delink_webhook_url": {
      "type": "string",
      "description": "Webhook URL to delink this repeater"
    },
    "dtmf_link_code": {
      "type": "string",
      "description": "DTMF code that triggers linking"
    },
    "dtmf_delink_code": {
      "type": "string",
      "description": "DTMF code that triggers delinking"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "linked",
        "maintenance"
      ],
      "default": "online"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}