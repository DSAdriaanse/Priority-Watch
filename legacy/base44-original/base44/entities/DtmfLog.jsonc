{
  "name": "DtmfLog",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "repeater_name": {
      "type": "string"
    },
    "node": {
      "type": "string"
    },
    "command_name": {
      "type": "string"
    },
    "dtmf": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "success",
        "error"
      ]
    },
    "output": {
      "type": "string",
      "description": "Decoded output on success, or the error message on failure"
    }
  },
  "required": [
    "repeater_name",
    "node",
    "command_name",
    "dtmf",
    "result"
  ]
}